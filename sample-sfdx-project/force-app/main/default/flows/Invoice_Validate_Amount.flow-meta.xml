<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Before-save flow on Invoice__c. Blocks an invoice whose Amount is zero or negative, and sets Status to Draft when Status is blank.</description>
    <label>Invoice Validate Amount</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Amount</targetReference>
        </connector>
        <object>Invoice__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <decisions>
        <name>Check_Amount</name>
        <label>Check Amount</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Check_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Amount OK</defaultConnectorLabel>
        <rules>
            <name>Amount_Not_Positive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Amount_Error</targetReference>
            </connector>
            <label>Amount not positive</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Status</name>
        <label>Check Status</label>
        <locationX>50</locationX>
        <locationY>400</locationY>
        <defaultConnectorLabel>Status set</defaultConnectorLabel>
        <rules>
            <name>Status_Is_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Default_Status</targetReference>
            </connector>
            <label>Status is blank</label>
        </rules>
    </decisions>
    <assignments>
        <name>Set_Default_Status</name>
        <label>Set Default Status</label>
        <locationX>50</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <name>Show_Amount_Error</name>
        <label>Show Amount Error</label>
        <locationX>300</locationX>
        <locationY>200</locationY>
        <customErrorMessages>
            <errorMessage>Amount must be greater than zero.</errorMessage>
            <fieldSelection>Amount__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
</Flow>
